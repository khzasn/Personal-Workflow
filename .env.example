# ============================================================
# Personal Productivity Dashboard (Dayflow) — Environment Variables
# ============================================================
# Salin file ini ke .env.local dan isi dengan nilai kredensial Anda.
# JANGAN PERNAH meng-commit file .env.local ke repositori git!
# ============================================================

# Public Supabase Configuration (Aman diakses client & server)
# Dapatkan dari: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Catatan: Jika menggunakan legacy anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# Server-only Supabase Administration (JANGAN PERNAH bocor ke client)
# Dapatkan dari: Supabase Dashboard → Project Settings → API (service_role secret)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here

# Google Gemini Server Configuration (JANGAN PERNAH bocor ke client)
# Dapatkan API Key dari: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# RSS Server Configuration: Format JSON Array (1 s/d 3 sumber feed HTTPS)
RSS_FEED_URLS=["https://www.cnbcindonesia.com/news/rss"]
RSS_CACHE_TTL_HOURS=24
RSS_MAX_ARTICLES_PER_FEED=5
RSS_REQUEST_TIMEOUT_MS=8000

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta
